# ============================================================
# BreatheIQ — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.

# OpenAQ API v3 key (free tier available at https://explore.openaq.org/register)
# Without this key, the app shows demo data with a clear warning banner.
OPENAQ_API_KEY=

# Optional: Gemini API key for AI-powered insights
# Without this, the AI Assistant uses a rule-based system (still functional).
# Free tier at https://aistudio.google.com
GEMINI_API_KEY=

